# Folio configuration — every variable from the spec's Configuration table.
# Copy to .env and fill in the required values; startup fails without them.

# Core (required, no defaults)
FOLIO_BASE_URL=https://folio.example.com
FOLIO_SECRET_KEY=change-me
# Used by local dev/tests; the compose stack overrides it to point at the db service.
DATABASE_URL=postgresql+psycopg://folio:folio@localhost:5432/folio

# Local dev writes here; the compose stack overrides it to the /data volume.
DATA_DIR=./data
MAX_UPLOAD_MB=200

# Postgres container (used by compose.yaml; DATABASE_URL above is for local dev)
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio
POSTGRES_DB=folio

# Image the compose stack runs. Set to a Harbor tag on the server to `docker compose pull`;
# leave unset to build locally.
# FOLIO_IMAGE=harbor.example.com/library/folio:latest

# LDAP (required)
LDAP_URL=ldaps://dc1.example.local:636
LDAP_BIND_DN=cn=folio-svc,ou=service,dc=example,dc=local
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=ou=users,dc=example,dc=local
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
FOLIO_LDAP_ADMIN_GROUP=cn=folio-admin,ou=groups,dc=example,dc=local
FOLIO_LDAP_USER_GROUP=cn=folio-user,ou=groups,dc=example,dc=local
# LDAP_CA_FILE defaults to the system store
# LDAP_CA_FILE=/etc/ssl/folio-ca.pem
LDAP_ALLOW_INSECURE=false

# TTS — required in production, optional until M4 (see docs/DECISIONS.md)
# TTS_BASE_URL=http://tts.example.local/v1
TTS_API_KEY=
TTS_MODEL=tts
# opus | mp3 | aac. aac lets Safari/iOS play a book as one HLS stream, so playback
# continues on a locked iPhone (docs/TTS.md); the TTS engine must offer aac.
TTS_FORMAT=opus
# TTS_DEFAULT_VOICE=ashley-en
TTS_VOICE_MAP={"en":"ashley-en","ja":"ashley-ja","ko":"ashley-kr","zh":"ashley-zh"}
TTS_VOICES=
TTS_VOICES_TTL=600
TTS_VOICE_LANG_PATTERN=-(en|ja|kr|ko|zh)$
# Send the narration prompt with each synthesis; set false for VoxCPM2 (see docs/TTS.md).
TTS_INSTRUCTIONS=true
TTS_MAX_CHARS=800
# Characters per TTS request; longer segments are split at sentences and joined (0 = one request)
TTS_REQUEST_CHARS=300
TTS_LOOKAHEAD=6
TTS_CONCURRENCY=2
TTS_CHARS_PER_SECOND=15
TTS_SPEED_MIN=0.9
TTS_SPEED_MAX=1.15
TTS_SPEED_STEP=0.05

# Audio cache and metadata
AUDIO_CACHE_MAX_GB=50
METADATA_ONLINE=true
GOOGLE_BOOKS_API_KEY=

# Test-only; never set this in production. compose.test.yaml sets it.
FOLIO_TEST_MODE=false
